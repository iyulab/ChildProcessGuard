<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- .NET Framework 4.8 exercises the netstandard2.0 build and its Microsoft.Bcl.AsyncInterfaces dependency -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net48;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChildProcessGuard\ChildProcessGuard.csproj" />
  </ItemGroup>

</Project>
